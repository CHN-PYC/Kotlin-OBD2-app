VEHICLE_AGENT_ENVIRONMENT=development
VEHICLE_AGENT_HOST=127.0.0.1
VEHICLE_AGENT_PORT=8000
VEHICLE_AGENT_API_KEY=
VEHICLE_AGENT_MODEL_PROVIDER=ollama
# API prefix only; the adapter appends /chat/completions.
VEHICLE_AGENT_LLM_BASE_URL=
VEHICLE_AGENT_LLM_MODEL=
VEHICLE_AGENT_LLM_API_KEY=
VEHICLE_AGENT_LLM_JSON_MODE=false
VEHICLE_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
VEHICLE_AGENT_OLLAMA_CHAT_MODEL=
VEHICLE_AGENT_OLLAMA_EMBEDDING_MODEL=bge-m3
# Set to 0 on low-VRAM GPUs that produce OOM/NaN during embedding; omit for auto.
VEHICLE_AGENT_OLLAMA_EMBEDDING_NUM_GPU=
VEHICLE_AGENT_EMBEDDING_BATCH_SIZE=16
VEHICLE_AGENT_MODEL_TIMEOUT_SECONDS=30
VEHICLE_AGENT_MODEL_MAX_OUTPUT_TOKENS=512
VEHICLE_AGENT_MODEL_MAX_ATTEMPTS=3
VEHICLE_AGENT_MODEL_RETRY_BASE_DELAY_SECONDS=0.1
VEHICLE_AGENT_REQUEST_DEADLINE_SECONDS=60
VEHICLE_AGENT_MODEL_CIRCUIT_FAILURE_THRESHOLD=5
VEHICLE_AGENT_MODEL_CIRCUIT_RECOVERY_SECONDS=30

# Persistent store for ingestion and API processes; use memory only for unit tests.
VEHICLE_AGENT_VECTOR_STORE_PROVIDER=qdrant
VEHICLE_AGENT_EMBEDDING_DIMENSION=1024
VEHICLE_AGENT_QDRANT_URL=http://127.0.0.1:6333
VEHICLE_AGENT_QDRANT_COLLECTION_NAME=vehicle_knowledge_v1
VEHICLE_AGENT_QDRANT_TIMEOUT_SECONDS=10
VEHICLE_AGENT_QDRANT_API_KEY=
VEHICLE_AGENT_RAG_CANDIDATE_MULTIPLIER=2
VEHICLE_AGENT_RETRIEVAL_MODE=hybrid
VEHICLE_AGENT_EVIDENCE_MIN_DENSE_SCORE=0.35
VEHICLE_AGENT_RERANKER_PROVIDER=pass_through
VEHICLE_AGENT_RERANKER_MODEL=BAAI/bge-reranker-base
VEHICLE_AGENT_RERANKER_BATCH_SIZE=8
VEHICLE_AGENT_RERANKER_THREADS=
VEHICLE_AGENT_SESSION_MEMORY_PROVIDER=redis
VEHICLE_AGENT_REDIS_URL=redis://127.0.0.1:6379/0
VEHICLE_AGENT_SESSION_TTL_SECONDS=1800
VEHICLE_AGENT_SESSION_MAX_TURNS=10
VEHICLE_AGENT_CONTEXT_MAX_CHARACTERS=16000
VEHICLE_AGENT_CONTEXT_MAX_HISTORY_TURNS=6
