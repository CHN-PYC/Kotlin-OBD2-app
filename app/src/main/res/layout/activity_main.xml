<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Top Toolbar with Status -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    style="@style/Widget.OBD2.Text.Title"
                    android:text="OBD2 Monitor" />

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    style="@style/Widget.OBD2.Text.Caption"
                    android:text="● Disconnected"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCurrentTime"
                style="@style/Widget.OBD2.Text.Subtitle"
                android:text="--:--"
                android:textColor="@color/accent" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <!-- Connection Status Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardConnectionStatus"
                style="@style/Widget.OBD2.Card"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivConnectionIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_bluetooth"
                        android:contentDescription="Status" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tvStatusTitle"
                            style="@style/Widget.OBD2.Text.Title"
                            android:text="Connected"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvStatusSubtitle"
                            style="@style/Widget.OBD2.Text.Subtitle"
                            android:text="OBD-II Scanner"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Go" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Connect to Car Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardConnect"
                style="@style/Widget.OBD2.Card.Elevated"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="24dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_bluetooth"
                        android:padding="12dp"
                        android:contentDescription="Connect"
                        android:background="@drawable/badge_background" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            style="@style/Widget.OBD2.Text.Title"
                            android:text="Connect to Car" />

                        <TextView
                            style="@style/Widget.OBD2.Text.Subtitle"
                            android:text="Connect to your vehicle's OBD2 adapter"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Go" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- View History Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardHistory"
                style="@style/Widget.OBD2.Card.Elevated"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="24dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_history"
                        android:padding="12dp"
                        android:contentDescription="History"
                        android:background="@drawable/badge_background" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            style="@style/Widget.OBD2.Text.Title"
                            android:text="View History" />

                        <TextView
                            style="@style/Widget.OBD2.Text.Subtitle"
                            android:text="Review past trip data and diagnostics"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Go" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Tips Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTips"
                style="@style/Widget.OBD2.Card"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_info"
                            android:contentDescription="Info" />

                        <TextView
                            style="@style/Widget.OBD2.Text.Title"
                            android:text="Quick Tips"
                            android:textSize="16sp"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <TextView
                        style="@style/Widget.OBD2.Text.Subtitle"
                        android:text="• Plug in OBD2 adapter before starting car\n• Pair device in Bluetooth settings first\n• Turn ignition to ON (don't start engine)\n• Long-press 'Connect' for detailed diagnostics"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Status Info -->
            <TextView
                android:id="@+id/tvStatus"
                style="@style/Widget.OBD2.Text.Caption"
                android:text="Ready to connect"
                android:layout_marginTop="24dp" />

            <!-- Bottom Spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:menu="@menu/bottom_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
