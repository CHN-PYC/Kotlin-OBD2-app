<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Top Toolbar with Connection Status -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/connectionIndicator"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_connection_live" />

                    <TextView
                        android:id="@+id/tvTitle"
                        style="@style/Widget.OBD2.Text.Title"
                        android:text="OBD2 Diagnostics"
                        android:layout_marginStart="8dp" />
                        
                    <View
                        android:id="@+id/simulationIndicator"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_simulation"
                        android:layout_marginStart="8dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTimestamp"
                    style="@style/Widget.OBD2.Text.Subtitle"
                    android:text="Live • --:--:--"
                    android:textColor="@color/accent"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnRefresh"
                style="@style/Widget.OBD2.Button.Icon"
                android:src="@drawable/ic_refresh"
                android:contentDescription="Refresh" />

            <ImageButton
                android:id="@+id/btnExport"
                style="@style/Widget.OBD2.Button.Icon"
                android:src="@drawable/ic_export"
                android:contentDescription="Export" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Connection Status Banner -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardConnectionBanner"
                style="@style/Widget.OBD2.Card"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_bluetooth"
                        android:contentDescription="Connected" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tvConnectedDevice"
                            style="@style/Widget.OBD2.Text.Title"
                            android:text="OBD-II Scanner"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvConnectionQuality"
                            style="@style/Widget.OBD2.Text.Status"
                            android:text="Signal: Excellent"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Metrics Grid (3 rows x 2 columns) -->
            <GridLayout
                android:id="@+id/metricsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <!-- RPM Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    style="@style/Widget.OBD2.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center_horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_rpm"
                            android:contentDescription="RPM" />

                        <TextView
                            style="@style/Widget.OBD2.Text.Subtitle"
                            android:text="RPM"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvRpm"
                            style="@style/Widget.OBD2.Text.Metric"
                            android:text="--"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvRpmStatus"
                            style="@style/Widget.OBD2.Text.Status"
                            android:text="Normal"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Coolant Temp Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    style="@style/Widget.OBD2.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center_horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_coolant"
                            android:contentDescription="Coolant" />

                        <TextView
                            style="@style/Widget.OBD2.Text.Subtitle"
                            android:text="Coolant"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvCoolantTemp"
                            style="@style/Widget.OBD2.Text.Metric"
                            android:text="-- °C"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvCoolantStatus"
                            style="@style/Widget.OBD2.Text.Status"
                            android:text="Normal"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Battery Voltage Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    style="@style/Widget.OBD2.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center_horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_battery"
                            android:contentDescription="Battery" />

                        <TextView
                            style="@style/Widget.OBD2.Text.Subtitle"
                            android:text="Battery"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvBattery"
                            style="@style/Widget.OBD2.Text.Metric"
                            android:text="-- V"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvBatteryStatus"
                            style="@style/Widget.OBD2.Text.Status"
                            android:text="Normal"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Intake Temp Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    style="@style/Widget.OBD2.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center_horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_intake"
                            android:contentDescription="Intake" />

                        <TextView
                            style="@style/Widget.OBD2.Text.Subtitle"
                            android:text="Intake"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvIntakeTemp"
                            style="@style/Widget.OBD2.Text.Metric"
                            android:text="-- °C"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvIntakeStatus"
                            style="@style/Widget.OBD2.Text.Status"
                            android:text="Normal"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Throttle Position Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    style="@style/Widget.OBD2.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center_horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_throttle"
                            android:contentDescription="Throttle" />

                        <TextView
                            style="@style/Widget.OBD2.Text.Subtitle"
                            android:text="Throttle"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvThrottle"
                            style="@style/Widget.OBD2.Text.Metric"
                            android:text="-- %"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvThrottleStatus"
                            style="@style/Widget.OBD2.Text.Status"
                            android:text="Normal"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Speed Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    style="@style/Widget.OBD2.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center_horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_rpm"
                            android:contentDescription="Speed" />

                        <TextView
                            style="@style/Widget.OBD2.Text.Subtitle"
                            android:text="Speed"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvSpeed"
                            style="@style/Widget.OBD2.Text.Metric"
                            android:text="-- km/h"
                            android:layout_marginTop="4dp" />

                        <TextView
                            style="@style/Widget.OBD2.Text.Caption"
                            android:text="Estimated"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </GridLayout>

            <!-- RPM Chart -->
            <TextView
                style="@style/Widget.OBD2.Text.Title"
                android:text="RPM History (Last 30s)"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="250dp"
                style="@style/Widget.OBD2.Card">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp" />
            </androidx.cardview.widget.CardView>

            <!-- Session Stats -->
            <TextView
                style="@style/Widget.OBD2.Text.Title"
                android:text="Session Stats"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_background"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.OBD2.Text.Caption"
                        android:text="Avg RPM" />

                    <TextView
                        android:id="@+id/tvAvgRpm"
                        style="@style/Widget.OBD2.Text.Metric"
                        android:text="--"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/card_border"
                    android:layout_marginHorizontal="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.OBD2.Text.Caption"
                        android:text="Max RPM" />

                    <TextView
                        android:id="@+id/tvMaxRpm"
                        style="@style/Widget.OBD2.Text.Metric"
                        android:text="--"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/card_border"
                    android:layout_marginHorizontal="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.OBD2.Text.Caption"
                        android:text="Duration" />

                    <TextView
                        android:id="@+id/tvDuration"
                        style="@style/Widget.OBD2.Text.Metric"
                        android:text="00:00"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:menu="@menu/bottom_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
