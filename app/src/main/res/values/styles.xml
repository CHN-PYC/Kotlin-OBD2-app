<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Button Styles -->
    <style name="Widget.OBD2.Button" parent="Widget.AppCompat.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.OBD2.Button.Primary" parent="Widget.OBD2.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.OBD2.Button.Secondary" parent="Widget.OBD2.Button">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Widget.OBD2.Button.Outline" parent="Widget.OBD2.Button">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.OBD2.Button.Icon" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/btn_icon</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="Widget.OBD2.Button.FAB" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_fab</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:elevation">6dp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Text Styles -->
    <style name="Widget.OBD2.Text.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.OBD2.Text.Subtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.OBD2.Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <style name="Widget.OBD2.Text.Metric">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="Widget.OBD2.Text.Status">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
